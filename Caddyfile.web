# ============================================================================
# Caddy — Frontend web (estático) + proxy del API en el MISMO dominio.
#
# Arquitectura detrás de reverse proxy externo (Traefik en VPS):
#   - Traefik gestiona Let's Encrypt exteriormente (HTTPS).
#   - Caddy corre en puerto 80 interno en texto claro (sin ACME/SSL).
#   - Sirve el frontend estático de Expo y cabeceras COOP/COEP (expo-sqlite).
# ============================================================================

{
	auto_https off
}

:80 {
	encode zstd gzip

	# --- API en el mismo origen → proxy al backend interno --------------------
	# Quita el prefijo /api antes de reenviar (el backend escucha en /v1, /health…).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# --- Sitio estático del frontend -----------------------------------------
	handle {
		root * /srv/www

		# Aislamiento de origen cruzado (requerido por expo-sqlite/WASM).
		header {
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
			Cross-Origin-Resource-Policy "same-origin"
			X-Content-Type-Options "nosniff"
		}

		# Los assets con hash (inmutables) se cachean un año.
		@hashed path /_expo/* /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html nunca se cachea, para que cada deploy tome efecto.
		@html path / /index.html
		header @html Cache-Control "no-cache"

		# MIME correcto para WebAssembly (compilación por streaming).
		@wasm path *.wasm
		header @wasm Content-Type "application/wasm"

		# Fallback SPA: rutas desconocidas → index.html (deep links / refresh).
		try_files {path} /index.html
		file_server
	}
}
