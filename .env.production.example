# ============================================================================
# VITMATERNA — Variables de entorno de PRODUCCIÓN (docker-compose.prod.yml)
#
#   cp .env.production.example .env
#   nano .env   # rellena los valores reales (NO commitear el .env real)
#
# Genera secretos fuertes con:
#   openssl rand -base64 36
# ============================================================================

# --- Dominio público de la API (para Caddy + HTTPS automático) -------------
# Debe tener un registro DNS A/AAAA apuntando a la IP de tu VPS.
API_DOMAIN=api.vitmaterna.pe

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=vitmaterna
POSTGRES_PASSWORD=CAMBIA_ESTO_password_muy_largo_y_aleatorio
POSTGRES_DB=vitmaterna

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CAMBIA_ESTO_password_redis_largo_y_aleatorio

# --- API / Backend ----------------------------------------------------------
API_PREFIX=/v1

# --- JWT (mínimo 32 caracteres cada uno) ------------------------------------
JWT_ACCESS_SECRET=CAMBIA_ESTO_access_secret_min_32_chars_aleatorio
JWT_REFRESH_SECRET=CAMBIA_ESTO_refresh_secret_min_32_chars_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS -------------------------------------------------------------------
# Orígenes permitidos (la app web/Expo). Separados por comas, sin espacios.
CORS_ORIGINS=https://app.vitmaterna.pe,https://api.vitmaterna.pe

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_MAX=1000

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Defaults clínicos ------------------------------------------------------
DEFAULT_ALTITUDE_MSNM=2926

# --- Bcrypt -----------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# --- Usuario admin del seed de producción -----------------------------------
# El seed de producción crea SOLO este usuario admin (sin datos demo).
# Cambia ADMIN_PASSWORD por una contraseña fuerte antes de sembrar.
ADMIN_DNI=99999999
ADMIN_PASSWORD=Admin@2026
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Sistema
ADMIN_PHONE=+51999999999
ADMIN_EMAIL=admin@vitmaterna.pe

# --- Canales de notificación ------------------------------------------------
# "mock" solo registra en consola. Para envío real, cambia el provider y
# rellena las credenciales correspondientes.
SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

WHATSAPP_PROVIDER=mock
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
