# ============================================
# VITMATERNA Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Server ---
NODE_ENV=development
PORT=3000
API_PREFIX=/v1

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://postgres:luis789JLQL%40@localhost:5432/vitmaterna_dev?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_MAX=1000

# --- Logging ---
LOG_LEVEL=debug

# --- Health Facility Defaults ---
DEFAULT_ALTITUDE_MSNM=2926

# --- Canales de Notificación ---
# Sin credenciales, los canales operan en modo "mock" (solo registran en consola).
# SMS vía Twilio: cambia SMS_PROVIDER a "twilio" y completa las credenciales.
SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# WhatsApp: elige el proveedor con WHATSAPP_PROVIDER.
#  - whatsapp_cloud: WhatsApp Business Cloud API de Meta (requiere plantillas HSM
#    para mensajes proactivos fuera de la ventana de 24h).
#  - openwa: gateway WhatsApp self-hosted y gratuito (https://open-wa.org). No
#    exige plantillas; ideal para recordatorios proactivos.
WHATSAPP_PROVIDER=mock
# --- Opción A: WhatsApp Business Cloud API (Meta) ---
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# --- Opción B: OpenWA (self-hosted) ---
# OPENWA_BASE_URL=https://openwa.qware.me
# OPENWA_API_KEY=owa_k1_...
# OPENWA_SESSION_ID=  # el ID (uuid) de la sesión, NO el nombre. Mira GET /api/sessions
# Webhooks entrantes (respuestas de la gestante por WhatsApp → chat). Secreto HMAC
# que debe coincidir con el `secret` del webhook registrado en OpenWA.
# OPENWA_WEBHOOK_SECRET=

# --- URL pública del backend (para enviar medios por WhatsApp por URL) ---
# Necesaria para reenviar imágenes del chat (#1.2) y miniaturas del contenido
# educativo (#6) por WhatsApp con OpenWA (send-image por URL). Debe ser https://
# y accesible por el gateway OpenWA. Vacío = los medios no se envían por URL.
# PUBLIC_BASE_URL=https://api.tudominio.pe

# --- External Services (future) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
