# ============================================
# VITMATERNA Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Server ---
NODE_ENV=development
PORT=3000
API_PREFIX=/v1

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://postgres:luis789JLQL%40@localhost:5432/vitmaterna_dev?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_MAX=1000

# --- Logging ---
LOG_LEVEL=debug

# --- Health Facility Defaults ---
DEFAULT_ALTITUDE_MSNM=2926

# --- External Services (future) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
