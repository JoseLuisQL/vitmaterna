# ============================================
# VITMATERNA Frontend — Variables de entorno
# ============================================
# Copia este archivo a ".env" y ajusta la URL según tu caso.
#
#   cp .env.example .env
#
# EXPO_PUBLIC_API_URL → URL del backend que usará la app.
#   - Web en la misma PC:        http://localhost:3000/v1
#   - Celular físico (misma red): http://TU_IP_LAN:3000/v1   (ej. 192.168.18.21)
#   - Producción:                https://api.vitmaterna.pe/v1
#
# Para saber tu IP de LAN:  Windows → ipconfig | Linux/Mac → ifconfig / ip a
# El celular y la PC deben estar en la MISMA red Wi-Fi.

EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# APP_ENV → "local" | "production".
#   local      → habilita HTTP en claro (cleartext) para backend local.
#   production → exige HTTPS (no cleartext).
APP_ENV=local
