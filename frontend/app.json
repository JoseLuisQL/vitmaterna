{
  "expo": {
    "name": "VITMATERNA",
    "slug": "vitmaterna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vitmaterna",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/737c7d16-a7de-44ed-a35d-1b77cfd320c6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitmaterna.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C8174",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vitmaterna.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0C8174"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VITMATERNA necesita acceso a tus fotos para que puedas enviar imágenes en el chat con tu obstetra."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VITMATERNA usa tu ubicación para enviar tu posición exacta al obstetra cuando activas una alerta de emergencia."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000/v1",
      "appEnv": "local",
      "eas": {
        "projectId": "737c7d16-a7de-44ed-a35d-1b77cfd320c6"
      },
      "router": {}
    },
    "owner": "luisdkbb"
  }
}
