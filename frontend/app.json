{
  "expo": {
    "name": "VITMATERNA",
    "slug": "vitmaterna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vitmaterna",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitmaterna.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vitmaterna.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#7468C4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VITMATERNA necesita acceso a tus fotos para que puedas enviar imágenes en el chat con tu obstetra."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VITMATERNA usa tu ubicación para enviar tu posición exacta al obstetra cuando activas una alerta de emergencia."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
