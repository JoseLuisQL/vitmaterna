    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.17.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "date-fns": "^4.4.0",
    "expo": "~56.0.9",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "^56.0.20",
    "expo-device": "^56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "^56.0.17",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-local-authentication": "~56.0.4",
    "expo-location": "~56.0.18",
    "expo-notifications": "~56.0.16",
    "expo-print": "^56.0.3",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.16",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "audit:design": "node scripts/audit-design.mjs",
    "audit:design:strict": "node scripts/audit-design.mjs --strict",
    "verify": "npm run tsc && npm run audit:design:strict && npm run test",
    "setup:hooks": "git -C .. config core.hooksPath .githooks && echo 'Hooks de git activados (.githooks).'",
    "build:apk:local": "eas build -p android --profile apk-local",
    "build:apk:preview": "eas build -p android --profile preview",
    "build:apk:prod": "eas build -p android --profile production-apk",
    "build:aab:prod": "eas build -p android --profile production",
    "build:apk:local:here": "eas build -p android --profile apk-local --local",
    "build:apk:prod:here": "eas build -p android --profile production-apk --local"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native))"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ]
  },
  "private": true
}
